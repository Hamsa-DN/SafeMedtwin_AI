# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real API keys. Each teammate keeps their own .env locally
# (or the team shares one key via a password manager, your call).

# --- LLM provider: set ONE of these (or both, and switch via the line below) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — force a specific provider instead of auto-detecting from
# whichever key above is set. Values: gemini | anthropic
# SAFEMEDTWIN_LLM_PROVIDER=gemini

# Optional — override the default models
# SAFEMEDTWIN_GEMINI_MODEL=gemini-flash-latest
# SAFEMEDTWIN_ANTHROPIC_MODEL=claude-sonnet-5
